# Testing environment configuration (Osool).
# BASE_URL is the ORIGIN of the application under test — scheme + host only, no
# path and no trailing slash. Page Objects append their own routes (/login,
# /workspace/projects, ...), so a path here would stack and break navigation.
# LANGUAGE selects both the framework locale strings and the app UI language
# (the specs navigate to /language/<lang>).
# Secrets (passwords) live here, never in test-data.
BASE_URL=https://test.osool.cloud
BASE_API=
API_KEY=
LANGUAGE=en
SUPERADMIN_EMAIL=superadmin@osool.sa
SUPERADMIN_PASSWORD=Tarqeem21
